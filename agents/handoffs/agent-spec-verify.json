{
  "$comment": "Typed handoff for agent-spec-verify (DV-057, P4-013). The dashboard validates the subagent's task and summary against this; text that does not parse is shown raw.",
  "version": "1.0.0",
  "input": {
    "type": "object",
    "required": ["command"],
    "properties": {
      "command": {"type": "string"},
      "cwd": {"type": "string"}
    }
  },
  "output": {
    "type": "object",
    "required": ["command", "verdict", "summary", "failures"],
    "properties": {
      "command": {"type": "string"},
      "verdict": {"type": "string", "enum": ["PASS", "FAIL", "ERROR"]},
      "summary": {"type": "string"},
      "failures": {
        "type": "array",
        "maxItems": 15,
        "items": {
          "type": "object",
          "required": ["test", "error"],
          "properties": {
            "test": {"type": "string"},
            "error": {"type": "string"},
            "location": {"type": "string"}
          }
        }
      }
    }
  }
}
